# Copie para .env.local e preencha. NUNCA versionar .env.local.

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# SECRETA — somente servidor (ações administrativas). Nunca prefixar com NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Domínio dos e-mails sintéticos do login por usuário (ex.: luciane@login.meurecibo.internal).
# Definir UMA vez: mudar depois exige migrar todos os usuários.
NEXT_PUBLIC_AUTH_EMAIL_DOMAIN=login.meurecibo.internal

# SECRETA — somente local, para aplicar migrations (npm run db:push) e gerar tipos.
# Supabase → Connect → Session pooler (porta 5432). Substitua [YOUR-PASSWORD].
SUPABASE_DB_URL=postgresql://postgres.SEU-PROJETO:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
